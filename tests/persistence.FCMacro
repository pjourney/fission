"""Two separate native launches validate preferences and layout persistence.

FISSION_PERSISTENCE_PHASE=write then read; both launches use
Fission.exe -u <repo>/test-output/persistence.cfg tests/persistence.FCMacro.
"""

import importlib
import json
import os
from pathlib import Path
import sys
import traceback

import FreeCAD as App
import FreeCADGui as Gui
from PySide import QtCore, QtWidgets
try:
    from PySide import QtTest
except ImportError:
    try:
        QtTest = importlib.import_module("PySide6.QtTest")
    except ImportError:
        QtTest = importlib.import_module("PySide2.QtTest")

REPO = Path(os.environ.get("FISSION_SOURCE_ROOT", r"C:\Users\juice_box_local\Desktop\fission")).resolve()
OUTPUT = Path(os.environ.get("FISSION_TEST_OUTPUT", str(REPO / "test-output"))).resolve()
OUTPUT.mkdir(parents=True, exist_ok=True)
PHASE = os.environ.get("FISSION_PERSISTENCE_PHASE", "")


def require(condition, message):
    if not condition:
        raise AssertionError(message)


def settle(milliseconds=250):
    QtWidgets.QApplication.processEvents()
    QtTest.QTest.qWait(milliseconds)


def geometry_state(controller):
    return {
        "width": controller.main.width(),
        "height": controller.main.height(),
        "x": controller.main.x(),
        "y": controller.main.y(),
        "maximized": controller.main.isMaximized(),
        "browser_width": controller.browser.width(),
        "timeline_height": controller.timeline.height(),
        "browser_visible": controller.browser.isVisible(),
        "timeline_visible": controller.timeline.isVisible(),
    }


def run_persistence_phase():
    report_file = OUTPUT / "persistence-report.json"
    controller = None
    if report_file.is_file() and PHASE == "read":
        report = json.loads(report_file.read_text(encoding="utf-8"))
    else:
        report = {"profile": str(OUTPUT / "persistence.cfg"), "phases": {}}
    result = {"phase": PHASE, "status": "failed"}
    try:
        require(PHASE in ("write", "read"), "Set FISSION_PERSISTENCE_PHASE to write or read")
        profile = Path(App.ConfigGet("UserParameter")).resolve()
        require(profile == (OUTPUT / "persistence.cfg").resolve(), "Persistence test requires isolated -u test-output/persistence.cfg")
        require(not App.listDocuments(), "Persistence launch must start without open design documents")
        Gui.activateWorkbench("FissionWorkbench")
        from fission.shell import get_controller
        from fission.preferences import PreferencesDialog
        from fission.shortcuts import ShortcutProfile
        controller = get_controller()
        controller.main.show()
        controller.main.activateWindow()
        controller.main.raise_()
        settle(350)
        if PHASE == "write":
            controller.main.showNormal()
            controller.main.resize(1280, 800)
            controller.main.move(100, 75)
            controller.browser.show()
            controller.timeline.show()
            preferences = PreferencesDialog(controller, controller.main)
            preferences.theme.setCurrentText("Light")
            preferences.navigation.setCurrentIndex(preferences.navigation.findData("Gui::CADNavigationStyle"))
            preferences.accept()  # Exercise the public preference commit without opening a modal dialog.
            controller.shortcuts.set_binding("Fission_Fillet", "Alt+F")
            controller.main.resizeDocks([controller.browser], [365], QtCore.Qt.Horizontal)
            controller.main.resizeDocks([controller.timeline], [180], QtCore.Qt.Vertical)
            settle(350)
            controller.save_layout()
            App.saveParameter()
            require(profile.is_file(), "First process must save its actual isolated user profile")
            require(controller.settings.GetString("Theme", "") == "Light", "Light theme must be stored")
            require(controller.settings.GetString("Navigation", "") == "Gui::CADNavigationStyle", "Alternate navigation must be stored")
            require(controller.shortcuts.shortcut_for("Fission_Fillet", "model") == "Alt+F", "Custom model F shortcut must be stored")
            require(bool(controller.settings.GetString("Geometry", "")) and bool(controller.settings.GetString("Layout", "")), "Both native window geometry and dock state must be stored")
            geometry = geometry_state(controller)
            require(abs(geometry["browser_width"] - 365) < 40, "Browser width request must be applied before save")
            result.update({"status": "passed", "theme": "Light", "navigation": "Gui::CADNavigationStyle", "fillet_shortcut": "Alt+F", "geometry": geometry, "layout": controller.settings.GetString("Layout", ""), "window_geometry": controller.settings.GetString("Geometry", ""), "config_bytes": profile.stat().st_size, "process_id": os.getpid()})
        else:
            written = report["phases"]["write"]
            require(written["status"] == "passed", "A successful write process must precede read")
            require(written["process_id"] != os.getpid(), "Read validation must run in a genuinely separate process")
            require(controller.settings.GetString("Theme", "") == "Light", "Light theme must survive application restart")
            require("#f5f7f9" in controller.main.styleSheet(), "Restored Light theme must be applied to real Qt widgets")
            require(controller.settings.GetString("Navigation", "") == "Gui::CADNavigationStyle", "Alternate navigation must survive restart")
            view_parameters = App.ParamGet("User parameter:BaseApp/Preferences/View")
            require(view_parameters.GetString("NavigationStyle", "") == "Gui::CADNavigationStyle", "Native view navigation preference must survive restart")
            require(controller.shortcuts.shortcut_for("Fission_Fillet", "model") == "Alt+F", "Custom model F mapping must load in the new manager")
            independently_loaded = ShortcutProfile()
            independently_loaded.load(controller.shortcuts.parameters)
            require(independently_loaded.overrides.get("Fission_Fillet") == "Alt+F", "Disk ParamGet profile must match the restored runtime shortcut")
            require(controller.settings.GetString("Layout", "") == written["layout"], "Persisted native dock state must match the writer")
            require(controller.settings.GetString("Geometry", "") == written["window_geometry"], "Persisted native window state must match the writer")
            geometry = geometry_state(controller)
            for name, tolerance in (("width", 20), ("height", 30), ("x", 35), ("y", 35), ("browser_width", 35), ("timeline_height", 35)):
                require(abs(geometry[name] - written["geometry"][name]) <= tolerance, "Restored {} differs: written {}, read {}".format(name, written["geometry"][name], geometry[name]))
            for name in ("maximized", "browser_visible", "timeline_visible"):
                require(geometry[name] == written["geometry"][name], "Restored state differs: " + name)
            require(not App.listDocuments(), "Preferences/layout test must remain independent of CAD documents")
            controller.main.grab().save(str(OUTPUT / "fission-persistence-light.png"))
            result.update({"status": "passed", "theme": "Light", "navigation": "Gui::CADNavigationStyle", "fillet_shortcut": "Alt+F", "geometry": geometry, "process_id": os.getpid()})
        App.Console.PrintMessage("FISSION PERSISTENCE {} PASS\n".format(PHASE))
    except Exception as exc:
        result.update({"error": str(exc), "traceback": traceback.format_exc()})
        App.Console.PrintError("FISSION PERSISTENCE {} FAIL: {}\n{}\n".format(PHASE, exc, result["traceback"]))
    finally:
        report["phases"][PHASE or "unknown"] = result
        report["passed"] = bool(report["phases"].get("write", {}).get("status") == "passed" and report["phases"].get("read", {}).get("status") == "passed")
        report_file.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
        (OUTPUT / ("persistence-{}-complete.txt".format(PHASE or "unknown"))).write_text("PASS\n" if result["status"] == "passed" else "FAIL\n", encoding="utf-8")
        if controller:
            controller.save_layout()
        QtCore.QTimer.singleShot(250, QtWidgets.QApplication.instance().quit)


QtCore.QTimer.singleShot(2000, run_persistence_phase)
